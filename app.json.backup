{
  "expo": {
    "name": "VisionWorldMart",
    "slug": "vwm",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/playstore.png",
    "scheme": "vwm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.vwm"
    },
    "android": {
      "permissions": ["INTERNET"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/playstore.png",
        "backgroundImage": "./assets/playstore.png",
        "monochromeImage": "./assets/playstore.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.vwm"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/playstore.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/playstore.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#082f49",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4eeadde-9158-434d-9572-4cd6411dd930"
      }
    }
  }
}
